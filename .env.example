# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (almacenamiento de imágenes: telas, trabajos, logo)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# Cloudflare Turnstile (anti-bots en el formulario público de citas)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Brevo (correos transaccionales)
# Ojo: si la cuenta tiene "Authorised IPs" activo en Brevo, hay que autorizar
# las IP de salida de Vercel o desactivar la restricción, o la API responde 401.
BREVO_API_KEY=
# Token del MCP de Brevo (opcional, solo para herramientas de desarrollo).
BREVO_MCP_API_KEY=
EMAIL_FROM_ADDRESS=info@johnhenryoficial.com
EMAIL_FROM_NAME=JOHN HENRY
EMAIL_REPLY_TO=info@johnhenryoficial.com
NOTIFY_STAFF_EMAIL=

# Google Calendar (service account con acceso al calendario de cada sede)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# URL pública del sitio (usada en enlaces de correo, metadata, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
