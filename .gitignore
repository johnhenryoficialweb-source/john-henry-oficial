# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data / imports (never commit client or brand assets)
/data/backups/
/data/new/*
!/data/new/.gitkeep
data/**/*.xlsx
data/**/*.xls
data/**/*.csv
data/**/*.json
data/**/*.pdf
data/**/*.png
data/**/*.html
bleixen-davo-favoritos.txt
*.code-workspace
.claude/settings.local.json
.impeccable/
